# Local values below are for `php artisan serve` on your own machine.
# On Render, these are set per-service in the dashboard (Environment tab),
# never committed to git:
#   - UAT service:  APP_ENV=staging,    APP_DEBUG=true,  APP_URL=<uat .onrender.com URL>
#   - Prod service: APP_ENV=production, APP_DEBUG=false, APP_URL=<prod .onrender.com URL>
#   - APP_KEY: generate a DIFFERENT one per environment with `php artisan key:generate --show`
#     and paste the output into that service's Render env vars.
#
# First admin account (seeded by AdminUserSeeder, only created if it doesn't
# already exist yet - safe to leave these commented out to use the defaults
# below, but set a real password on Production via Render's env vars rather
# than relying on the default.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=12345678
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# LOCAL dev uses MySQL (values below). On Render, both UAT and Production use
# Render's native managed Postgres instead — DO NOT set DB_HOST/DB_PORT/etc.
# individually there. Instead, on each Render web service's Environment tab set
# just these two:
#   DB_CONNECTION=pgsql
#   DATABASE_URL=<the Postgres instance's "Internal Database URL" from Render>
# Laravel's pgsql connection (config/database.php) already reads DATABASE_URL
# automatically and overrides host/port/db/user/password from it — no other
# DB_* vars needed on Render. Use a SEPARATE Render Postgres instance for UAT
# and for Production (two different DATABASE_URL values) so UAT can never
# accidentally touch production data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
# NOTE: On Render's free tier the filesystem is ephemeral — anything written
# here (including complaint attachment uploads) is wiped on every redeploy.
# Acceptable for now during UAT; switch to an S3-compatible disk before
# relying on this for real uploads.
FILESYSTEM_DISK=local
# `database` runs jobs (currently just payment proof OCR - see
# app/Jobs/ProcessPaymentProofOcr.php) on a separate worker process instead
# of inline during the request - see README's Getting started (local:
# `php artisan queue:work`) and Deployment (Render: a dedicated worker
# service) sections. `sync` runs jobs inline immediately, no worker needed -
# fine for a quick local check, but defeats the point of queueing (the
# request blocks on OCR again, same as before this feature existed).
QUEUE_CONNECTION=database
# `file` is fine for local dev (persistent disk on your own machine). On
# Render, set SESSION_DRIVER=database instead — the free-tier filesystem is
# wiped on every restart (including waking from sleep), which silently logs
# everyone out since their session file is gone. The `sessions` table
# already exists via migration, so this is just an env var change, no code.
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Chat / Laravel Reverb (WebSocket broadcasting) ---
# LOCAL: run `php artisan reverb:start` in a second terminal alongside
# `php artisan serve`, and these defaults work as-is.
#
# RENDER: Reverb runs as its OWN separate Web Service (not this one) - see
# README for the exact setup. On BOTH the main app service and the Reverb
# service, set matching REVERB_APP_ID/KEY/SECRET (the app authenticates
# broadcasts *to* Reverb using these - they must be identical on both
# services). REVERB_HOST/PORT/SCHEME on the main app service point at the
# Reverb service's public onrender.com URL (port 443, scheme https) - the
# server-to-server call that triggers a broadcast goes out over the public
# internet in this simple v1 setup, not Render's private network.
#
# NOTE: the frontend does NOT read these via Vite's import.meta.env/VITE_*
# (deliberately) - Vite bakes those in at `docker build` time, but Render
# only injects real env vars at container *runtime*, so a build-time value
# would be wrong (or blank) on Render. Instead, resources/js/chat.js reads
# the Reverb key/host/port/scheme from data-* attributes rendered by Blade
# using config('reverb...'), which correctly reads the real runtime env
# (config is cached fresh on every container start - see docker/entrypoint.sh).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Error monitoring (Sentry) ---
# Optional locally - leave blank and the app runs exactly the same, errors
# just aren't reported anywhere. On Render, set a real DSN per environment
# (same Sentry project for uat and production is fine; SENTRY_ENVIRONMENT
# below is what tells them apart in the Sentry dashboard) - see README.
# Get a DSN by creating a project at https://sentry.io (free tier is enough
# for this app's scale) - Platform: Laravel.
SENTRY_LARAVEL_DSN=
# Defaults to APP_ENV if left blank - set explicitly so Render's "staging"/
# "production" APP_ENV values (see the note near the top of this file) show
# up in Sentry exactly as expected, not as some auto-guessed value.
SENTRY_ENVIRONMENT=
