# Local values below are for `php artisan serve` on your own machine.
# On Render, these are set per-service in the dashboard (Environment tab),
# never committed to git:
#   - UAT service:  APP_ENV=staging,    APP_DEBUG=true,  APP_URL=<uat .onrender.com URL>
#   - Prod service: APP_ENV=production, APP_DEBUG=false, APP_URL=<prod .onrender.com URL>
#   - APP_KEY: generate a DIFFERENT one per environment with `php artisan key:generate --show`
#     and paste the output into that service's Render env vars.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# On Render: DB_HOST/DB_PORT are your MySQL private service's internal address
# (Render shows this as the service's "Internal Database URL" / host); use a
# separate DB_DATABASE per environment (e.g. complaint_uat / complaint_prod)
# against the same MySQL instance, with separate DB_USERNAME/DB_PASSWORD per DB.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# NOTE: On Render's free tier the filesystem is ephemeral — anything written
# here (including complaint attachment uploads) is wiped on every redeploy.
# Acceptable for now during UAT; switch to an S3-compatible disk before
# relying on this for real uploads.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
